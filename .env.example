# ============================================================================
# .env.example —— docker-compose 环境变量模板
#
# 用法：
#   1) 复制一份为 .env（.env 已被 .gitignore 忽略，不会提交到仓库）
#        Windows PowerShell: Copy-Item .env.example .env
#        Linux / macOS / Git Bash: cp .env.example .env
#   2) 按需修改下面的值，然后执行 docker compose up -d
#   3) 不改也能跑：未设置的变量会使用 docker-compose.yml 中 ${变量:-默认值} 的默认值
#
# 说明：本文件只放「非敏感、可公开」的模板值；真实环境的密码请只写在 .env 中，不要提交。
# ============================================================================

# ---------- MySQL 相关 ----------
# MySQL root 账号密码（仅容器内部与初始化脚本使用，不对外暴露业务连接）
MYSQL_ROOT_PASSWORD=root
# 业务数据库名（与 backend/src/main/resources/application.yml、CI 保持一致，请勿随意改动）
MYSQL_DATABASE=apartment_rental_db
# 业务数据库账号（对齐 application.yml 的 username=apartment）
MYSQL_USER=apartment
# 业务数据库密码（对齐 application.yml 的 password=123456）
MYSQL_PASSWORD=123456
# MySQL 映射到宿主机的端口；若本机已装 MySQL 占用 3306，改成 3307 等空闲端口
MYSQL_PORT=3306

# ---------- 后端相关 ----------
# 后端映射到宿主机的端口；test/automation 的 BASE_URL 默认就是 http://localhost:8080
# 若本机已有后端在跑（占用 8080），改这里并同步调整 BASE_URL
BACKEND_PORT=8080

# ---------- 前端相关 ----------
# 前端映射到宿主机的端口；UI 用例的 UI_BASE_URL 默认就是 http://localhost:5173
# 若本机已有前端在跑（占用 5173），改这里并同步调整 UI_BASE_URL
FRONTEND_PORT=5173
# 构建前端镜像时容器内安装 npm 依赖所用的源。
# 默认用国内镜像（与开发机 npm 配置一致）；若网络环境可直接访问官方源，改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com