# ============================================================================
# backend/.dockerignore —— 后端构建上下文排除清单
#
# 作用：
#   指定 docker build 时「不发送给 Docker 守护进程」的文件。
#   backend/target 目录体积大（含已编译的 class 与旧 jar），
#   排除后能显著减小构建上下文、加快构建；同时避免旧产物污染镜像内的构建结果。
#
# 语法提醒：.dockerignore 只支持「整行注释」，即 # 必须位于行首。
# ============================================================================

# ---------- 构建产物 ----------
# 本地已编译的产物：镜像内会重新执行 mvn package 生成，无需传入
target/
# 拷贝进来的旧 jar / war，避免与本次构建结果混淆
*.jar
*.war
# 本地编译的 class 文件
*.class

# ---------- 版本控制与 IDE ----------
# git 元数据与历史，对构建无用且体积大
.git/
.gitignore
.gitattributes
# IntelliJ IDEA 工程配置
.idea/
*.iml
# 编辑器临时文件
*.swp
*.swo

# ---------- 本地运行期产物 ----------
# 文件上传目录（本地测试上传的文件，不应进镜像）
uploads/
# Spring Boot 本地日志
*.log
# 本地环境变量文件（含密码，绝不进镜像）
.env
.env.local

# ---------- 容器与脚本 ----------
# 避免把 Dockerfile 自身与 compose 文件重复打进去
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.yaml

# ---------- 操作系统生成的垃圾文件 ----------
.DS_Store
Thumbs.db